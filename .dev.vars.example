# 認証の秘密の値。本番では使い回さず、`openssl rand -base64 32` などで作った値を
# `wrangler secret put <NAME>` で設定する。
# AUTH_PASSWORD_PEPPER を変えると保存済みのパスワードがすべて照合できなくなる。
# AUTH_JWT_SECRET を変えると発行済みのセッションがすべて無効になる。
AUTH_JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production
AUTH_PASSWORD_PEPPER=dev-only-password-pepper-do-not-use-in-production
AUTH_OTP_SECRET=dev-only-otp-secret-do-not-use-in-production

# 再設定リンクの URL の起点と、メールの差出人。
PUBLIC_BASE_URL=http://localhost:5173
MAIL_FROM=noreply@example.com
